@model List<EMS.Models.Employee>

<h2>Employee List</h2>

<table border="1" cellpadding="10">
    <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Department</th>
        <th>Salary</th>
    </tr>

    @foreach ( var employee in Model)
    {
        <tr>
            <td>@employee.Name</td>
            <td>@employee.Email</td>
            <td>@employee.Department</td>
            <td>@employee.Salary</td>
        </tr>
    }
</table>