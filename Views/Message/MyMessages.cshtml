@model List<EMS.Models.Message>

@{
    ViewData["Title"] = "My Messages";

    TimeZoneInfo bdTimeZone;

    try
    {
        bdTimeZone = TimeZoneInfo.FindSystemTimeZoneById("Asia/Dhaka");
    }
    catch
    {
        bdTimeZone = TimeZoneInfo.FindSystemTimeZoneById("Bangladesh Standard Time");
    }
}

<style>
    .messages-page {
        min-height: 80vh;
        background: #f8fafc;
        padding: 35px 15px 50px;
    }

    .messages-header {
        max-width: 1000px;
        margin: 0 auto 25px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .messages-title {
        font-size: 30px;
        font-weight: 800;
        color: #1e293b;
        margin: 0;
    }

    .messages-subtitle {
        color: #64748b;
        margin-top: 5px;
        margin-bottom: 0;
    }

    .message-card {
        max-width: 1000px;
        margin: 0 auto 18px;
        background: white;
        border: 0;
        border-radius: 16px;
        box-shadow: 0 8px 22px rgba(15, 23, 42, 0.07);
        overflow: hidden;
        transition: all 0.2s ease;
    }

    .message-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.10);
    }

    .message-top {
        padding: 20px 22px;
        border-bottom: 1px solid #eef2f7;
    }

    .subject {
        font-size: 18px;
        font-weight: 750;
        color: #1e293b;
        margin-bottom: 6px;
    }

    .message-date {
        font-size: 12px;
        color: #94a3b8;
    }

    .message-content {
        padding: 20px 22px;
    }

    .label {
        font-size: 12px;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        margin-bottom: 6px;
    }

    .message-text {
        color: #334155;
        line-height: 1.7;
        white-space: pre-wrap;
        margin-bottom: 18px;
    }

    .reply-box {
        background: #f0fdf4;
        border-left: 4px solid #198754;
        border-radius: 10px;
        padding: 15px 16px;
    }

    .reply-text {
        color: #334155;
        line-height: 1.7;
        white-space: pre-wrap;
        margin: 0;
    }

    .pending-box {
        background: #fff8e1;
        border-left: 4px solid #ffc107;
        border-radius: 10px;
        padding: 14px 16px;
        color: #8a6d1d;
    }

    .status-badge {
        font-size: 11px;
        font-weight: 700;
        padding: 6px 10px;
        border-radius: 20px;
    }

    .empty-card {
        max-width: 650px;
        margin: 60px auto;
        text-align: center;
        background: white;
        padding: 45px 25px;
        border-radius: 18px;
        box-shadow: 0 8px 22px rgba(15, 23, 42, 0.07);
    }
</style>


<div class="messages-page">

    <!-- Header -->
    <div class="messages-header">

        <div>
            <h2 class="messages-title">
                💬 My Messages
            </h2>

            <p class="messages-subtitle">
                View your messages and replies from the administrator.
            </p>
        </div>

        <div>
            <a asp-action="Create"
               class="btn btn-primary"
               style="border-radius:10px;">
                ✉️ New Message
            </a>
        </div>

    </div>


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mx-auto"
             style="max-width:1000px; border-radius:12px;">
            ✅ @TempData["Success"]
        </div>
    }


    @if (!Model.Any())
    {
        <div class="empty-card">

            <div style="font-size:50px;">
                📭
            </div>

            <h4 class="mt-3">
                No Messages Yet
            </h4>

            <p class="text-muted">
                You haven't sent any messages to the administrator.
            </p>

            <a asp-action="Create"
               class="btn btn-primary"
               style="border-radius:10px;">
                Send Your First Message
            </a>

        </div>
    }
    else
    {
        @foreach (var message in Model)
        {
            var bangladeshTime = TimeZoneInfo.ConvertTimeFromUtc(
                DateTime.SpecifyKind(
                    message.CreatedAt,
                    DateTimeKind.Utc),
                bdTimeZone);

            <div class="message-card">

                <!-- Message Header -->
                <div class="message-top">

                    <div class="d-flex justify-content-between align-items-start gap-3">

                        <div>

                            <div class="subject">
                                @message.Subject
                            </div>

                            <div class="message-date">
                                Sent on
                                @bangladeshTime.ToString(
                                    "dd MMM yyyy hh:mm tt")
                            </div>

                        </div>


                        @if (message.Status == "Replied")
                        {
                            <span class="status-badge bg-success text-white">
                                Replied
                            </span>
                        }
                        else
                        {
                            <span class="status-badge bg-warning text-dark">
                                Pending
                            </span>
                        }

                    </div>

                </div>


                <!-- Message Body -->
                <div class="message-content">

                    <div class="label">
                        Your Message
                    </div>

                    <div class="message-text">
                        @message.MessageText
                    </div>


                    <!-- Reply -->
                    @if (!string.IsNullOrWhiteSpace(message.Reply))
                    {
                        <div class="reply-box">

                            <div class="label text-success">
                                Admin Reply
                            </div>

                            <p class="reply-text">
                                @message.Reply
                            </p>

                            @if (message.RepliedAt.HasValue)
                            {
                                var replyTime =
                                    TimeZoneInfo.ConvertTimeFromUtc(
                                        DateTime.SpecifyKind(
                                            message.RepliedAt.Value,
                                            DateTimeKind.Utc),
                                        bdTimeZone);

                                <div class="message-date mt-2">
                                    Replied on
                                    @replyTime.ToString(
                                        "dd MMM yyyy hh:mm tt")
                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="pending-box">
                            ⏳ Your message is waiting for an administrator reply.
                        </div>
                    }

                </div>

            </div>
        }
    }

</div>