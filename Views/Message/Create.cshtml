@model EMS.Models.Message

@{
    ViewData["Title"] = "Contact Admin";
}

<style>
    .message-page {
        min-height: 80vh;
        padding: 40px 15px;
        background: #f8fafc;
    }

    .message-card {
        max-width: 650px;
        margin: auto;
        border: 0;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 12px 30px rgba(0,0,0,0.08);
    }

    .message-header {
        background: linear-gradient(135deg, #0d6efd, #6610f2);
        color: white;
        padding: 25px;
        text-align: center;
    }

    .message-header h2 {
        margin: 0;
        font-weight: 700;
    }

    .message-body {
        padding: 30px;
        background: white;
    }

    .form-label {
        font-weight: 600;
    }

    .form-control {
        border-radius: 10px;
        padding: 12px;
        border-color: #dbe2ea;
    }

    .form-control:focus {
        border-color: #6366f1;
        box-shadow: 0 0 0 3px rgba(99,102,241,.10);
    }

    textarea.form-control {
        min-height: 160px;
        resize: vertical;
    }

    .send-btn {
        border: 0;
        border-radius: 10px;
        padding: 12px 20px;
        font-weight: 700;
        background: linear-gradient(135deg, #0d6efd, #4f46e5);
    }
</style>

<div class="message-page">

    <div class="message-card">

        <div class="message-header">

            <div style="font-size:40px;">
                💬
            </div>

            <h2>Contact Admin</h2>

            <p class="mb-0 opacity-75">
                Send your message or issue to the administrator
            </p>

        </div>

        <div class="message-body">

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            }

            <form asp-action="Create" method="post">

                <!-- Subject -->
                <div class="mb-4">

                    <label asp-for="Subject" class="form-label">
                        Subject
                    </label>

                    <input asp-for="Subject"
                           class="form-control"
                           placeholder="Enter message subject"
                           required />

                    <span asp-validation-for="Subject"
                          class="text-danger">
                    </span>

                </div>

                <!-- Message -->
                <div class="mb-4">

                    <label asp-for="MessageText" class="form-label">
                        Your Message
                    </label>

                    <textarea asp-for="MessageText"
                              class="form-control"
                              placeholder="Write your message here..."
                              required></textarea>

                    <span asp-validation-for="MessageText"
                          class="text-danger">
                    </span>

                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary send-btn">
                        📩 Send Message
                    </button>

                    <a asp-action="MyMessages"
                       class="btn btn-outline-secondary"
                       style="border-radius:10px; padding:12px 20px;">
                        📬 My Messages
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}