@model List<EMS.Models.Product>

@{
    ViewData["Title"] = "User Dashboard";
}

<div class="container mt-4">

    <!-- Hero Banner -->
    <div class="hero-banner mb-5">

        <div class="row align-items-center">

            <div class="col-md-7">

                <h1 class="display-5 fw-bold">
                    Welcome,
                    @Context.Session.GetString("UserName")
                </h1>

                <h4 class="mt-3">
                    🛍 Discover Amazing Products
                </h4>

                <p class="mt-3">
                    Shop the latest Electronics, Smart Watches, Accessories and much more at the best price.
                </p>

            </div>

            <div class="col-md-5 text-center">

                <img src="https://cdn-icons-png.flaticon.com/512/3081/3081559.png"
                     width="250"
                     alt="Shopping" />

            </div>

        </div>

    </div>


    <!-- Quick Buttons -->
    <div class="row mb-4">

        <!-- My Cart -->
        <div class="col-md-6 col-lg-3 mb-3">

            <a asp-controller="Cart"
               asp-action="Index"
               class="btn btn-warning w-100">
                🛒 My Cart
            </a>

        </div>


        <!-- My Orders -->
        <div class="col-md-6 col-lg-3 mb-3">

            <a asp-controller="Order"
               asp-action="MyOrders"
               class="btn btn-success w-100">
                📦 My Orders
            </a>

        </div>


        <!-- My Messages -->
        <div class="col-md-6 col-lg-3 mb-3">

            <a asp-controller="Message"
               asp-action="MyMessages"
               class="btn btn-info w-100">
                💬 My Messages
            </a>

        </div>


        <!-- My Profile -->
        <div class="col-md-6 col-lg-3 mb-3">

            <a asp-controller="Profile"
               asp-action="Index"
               class="btn btn-dark w-100">
                👤 My Profile
            </a>

        </div>

    </div>


    <hr />


    <!-- Featured Products -->
    <h3 class="mb-4">
        🔥 Featured Products
    </h3>


    <div class="row">

        @foreach (var item in Model)
        {
            <div class="col-6 col-sm-6 col-md-4 col-lg-2 mb-4">

                <div class="card shadow-sm h-100">


                    <!-- Product Image -->
                    @if (!string.IsNullOrEmpty(item.Image))
                    {
                        <img src="~/images/products/@item.Image"
                             asp-append-version="true"
                             class="card-img-top"
                             alt="@item.ProductName"
                             style="height:220px; width:100%; object-fit:cover;" />
                    }
                    else
                    {
                        <div class="d-flex justify-content-center align-items-center bg-light"
                             style="height:220px;">

                            <span class="text-muted">
                                No Image
                            </span>

                        </div>
                    }


                    <!-- Product Information -->
                    <div class="card-body">

                        <h5 class="card-title">
                            @item.ProductName
                        </h5>

                        <p class="text-muted">
                            @item.Category
                        </p>

                        <h4 class="text-success">
                            ৳ @item.Price
                        </h4>


                        <!-- Stock Status -->
                        @if (item.Stock > 5)
                        {
                            <span class="badge bg-success">
                                In Stock
                            </span>
                        }
                        else if (item.Stock > 0)
                        {
                            <span class="badge bg-warning text-dark">
                                Low Stock
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Out of Stock
                            </span>
                        }

                    </div>


                    <!-- Product Actions -->
                    <div class="card-footer bg-white border-0">

                        <div class="d-grid gap-2">


                            <!-- Add To Cart -->
                            <a asp-controller="Cart"
                               asp-action="Add"
                               asp-route-id="@item.Id"
                               class="btn btn-primary">

                                🛒 Add To Cart

                            </a>


                            <!-- Buy Now -->
                            @if (item.Stock > 0)
                            {
                                <a asp-controller="Order"
                                   asp-action="BuyNow"
                                   asp-route-id="@item.Id"
                                   class="btn btn-success">

                                    ⚡ Buy Now

                                </a>
                            }
                            else
                            {
                                <button type="button"
                                        class="btn btn-secondary"
                                        disabled>

                                    Out of Stock

                                </button>
                            }


                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

</div>