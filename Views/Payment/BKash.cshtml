@{
    ViewData["Title"] = "bKash Payment";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-5">

            <div class="card shadow-lg border-0">

                <div class="card-header text-center text-white"
                     style="background:#E2136E;">

                    <h3 class="mb-0">
                        bKash Payment
                    </h3>

                </div>

                <div class="card-body">

                    <div class="text-center mb-4">

                        <h5>Safe Payment</h5>

                       <p class="text-muted">
                            Complete your payment using bKash.
                        </p>

                    </div>

                    <form asp-action="Success"
                          method="post"
                          id="bkashForm">

                        <div class="mb-3">

                            <label for="bkashNumber" class="form-label">
                                bKash Number
                            </label>

                            <input id="bkashNumber"
                                   name="bkashNumber"
                                   class="form-control"
                                   type="tel"
                                   placeholder="01712345678"
                                   maxlength="11"
                                   inputmode="numeric"
                                   required />

                            <div id="bkashNumberError"
                                 class="text-danger mt-1">
                            </div>

                        </div>

                        <div class="mb-4">

                            <label for="pin" class="form-label">
                                PIN
                            </label>

                            <input id="pin"
                                   name="pin"
                                   class="form-control"
                                   type="password"
                                   placeholder="4-digit PIN"
                                   maxlength="4"
                                   inputmode="numeric"
                                   required />

                            <div id="pinError"
                                 class="text-danger mt-1">
                            </div>

                        </div>

                        <button type="submit"
                                class="btn w-100 text-white"
                                style="background:#E2136E;">

                            Pay Now

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

<script>

    const bkashForm = document.getElementById("bkashForm");
    const bkashNumber = document.getElementById("bkashNumber");
    const pin = document.getElementById("pin");

    const bkashNumberError =
        document.getElementById("bkashNumberError");

    const pinError =
        document.getElementById("pinError");

    bkashForm.addEventListener("submit", function (event) {

        let valid = true;

        bkashNumberError.textContent = "";
        pinError.textContent = "";

        // Bangladesh mobile number validation
        const phonePattern = /^01[3-9]\d{8}$/;

        if (!phonePattern.test(bkashNumber.value.trim())) {

            bkashNumberError.textContent =
                "Enter a valid 11-digit Bangladesh mobile number.";

            bkashNumber.focus();

            valid = false;
        }

        // PIN validation
        const pinPattern = /^\d{4}$/;

        if (!pinPattern.test(pin.value.trim())) {

            pinError.textContent =
                "PIN must contain exactly 4 digits.";

            if (valid) {
                pin.focus();
            }

            valid = false;
        }

        // Stop form submission if invalid
        if (!valid) {
            event.preventDefault();
        }

    });

</script>