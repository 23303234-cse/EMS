@{
    ViewData["Title"] = "Nagad Payment";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-5">

            <div class="card shadow-lg border-0">

                <div class="card-header text-white text-center"
                     style="background:#F58220;">

                    <h3 class="mb-0">
                        Nagad Payment
                    </h3>

                </div>

                <div class="card-body">

                    <div class="text-center mb-4">

                        <h5>Safe Payment</h5>

                        <p class="text-muted">
                            Complete your payment using Nagad.
                        </p>

                    </div>

                    <form asp-action="Success"
                          method="post"
                          id="nagadForm">

                        <div class="mb-3">

                            <label for="nagadNumber" class="form-label">
                                Nagad Number
                            </label>

                            <input id="nagadNumber"
                                   name="nagadNumber"
                                   type="tel"
                                   class="form-control"
                                   placeholder="01712345678"
                                   maxlength="11"
                                   inputmode="numeric"
                                   required>

                            <div id="nagadNumberError"
                                 class="text-danger mt-1">
                            </div>

                        </div>

                        <div class="mb-4">

                            <label for="nagadPin" class="form-label">
                                PIN
                            </label>

                            <input id="nagadPin"
                                   name="pin"
                                   type="password"
                                   class="form-control"
                                   placeholder="4-digit PIN"
                                   maxlength="4"
                                   inputmode="numeric"
                                   required>

                            <div id="nagadPinError"
                                 class="text-danger mt-1">
                            </div>

                        </div>

                        <button type="submit"
                                class="btn w-100 text-white"
                                style="background:#F58220;">

                            Pay Now

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

<script>

    const nagadForm = document.getElementById("nagadForm");
    const nagadNumber = document.getElementById("nagadNumber");
    const nagadPin = document.getElementById("nagadPin");

    const nagadNumberError =
        document.getElementById("nagadNumberError");

    const nagadPinError =
        document.getElementById("nagadPinError");

    nagadForm.addEventListener("submit", function (event) {

        let valid = true;

        nagadNumberError.textContent = "";
        nagadPinError.textContent = "";

        // Bangladesh mobile number validation
        const phonePattern = /^01[3-9]\d{8}$/;

        if (!phonePattern.test(nagadNumber.value.trim())) {

            nagadNumberError.textContent =
                "Enter a valid 11-digit Bangladesh mobile number.";

            nagadNumber.focus();

            valid = false;
        }

        // PIN validation
        const pinPattern = /^\d{4}$/;

        if (!pinPattern.test(nagadPin.value.trim())) {

            nagadPinError.textContent =
                "PIN must contain exactly 4 digits.";

            if (valid) {
                nagadPin.focus();
            }

            valid = false;
        }

        // Stop form submission if invalid
        if (!valid) {
            event.preventDefault();
        }

    });

</script>