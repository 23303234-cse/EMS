@model List<EMS.Models.Order>

@{
    ViewData["Title"] = "All Orders";
}

<div class="container mt-4">

    <h2 class="mb-4">📦 All Orders</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No orders found.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-hover align-middle">

                <thead class="table-dark">

                    <tr>

                        <th>User</th>

                        <th>Order Date</th>

                        <th>Total</th>

                        <th>Payment Method</th>

                        <th>Payment Status</th>

                        <th>Order Status</th>

                        <th>Details</th>

                    </tr>

                </thead>

                <tbody>

                @foreach (var order in Model)
                {
                    <tr>

                        <td>
                            @order.UserEmail
                        </td>

                        <td>
                            @order.OrderDate.ToString("dd MMM yyyy hh:mm tt")
                        </td>

                        <td>
                            <strong>৳ @order.TotalAmount</strong>
                        </td>

                        <td>

                            @if (order.PaymentMethod == "bKash")
                            {
                                <span class="badge bg-danger">
                                    @order.PaymentMethod
                                </span>
                            }
                            else if (order.PaymentMethod == "Nagad")
                            {
                                <span class="badge bg-warning text-dark">
                                    @order.PaymentMethod
                                </span>
                            }
                            else if (order.PaymentMethod == "Credit/Debit Card")
                            {
                                <span class="badge bg-primary">
                                    Card
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Cash on Delivery
                                </span>
                            }

                        </td>

                        <td>

                            @if (order.PaymentStatus == "Paid")
                            {
                                <span class="badge bg-success">
                                    Paid
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    Pending
                                </span>
                            }

                        </td>

                        <td>

                            <form asp-action="UpdateStatus" method="post">

                                <input type="hidden"
                                       name="id"
                                       value="@order.Id" />

                                <select class="form-select"
                                        name="status"
                                        onchange="this.form.submit()">

                                    @if (order.Status == "Pending")
                                    {
                                        <option value="Pending" selected>
                                            Pending
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="Pending">
                                            Pending
                                        </option>
                                    }

                                    @if (order.Status == "Processing")
                                    {
                                        <option value="Processing" selected>
                                            Processing
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="Processing">
                                            Processing
                                        </option>
                                    }

                                    @if (order.Status == "Delivered")
                                    {
                                        <option value="Delivered" selected>
                                            Delivered
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="Delivered">
                                            Delivered
                                        </option>
                                    }

                                    @if (order.Status == "Cancelled")
                                    {
                                        <option value="Cancelled" selected>
                                            Cancelled
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="Cancelled">
                                            Cancelled
                                        </option>
                                    }

                                </select>

                            </form>

                        </td>

                        <td>

                            <a asp-action="Details"
                               asp-route-id="@order.Id"
                               class="btn btn-primary btn-sm">

                                View Details

                            </a>

                        </td>

                    </tr>
                }

                </tbody>

            </table>

        </div>
    }

</div>