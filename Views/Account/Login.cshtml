@model EMS.Models.User

@{
    ViewData["Title"] = "Login";
}

<style>
    body {
        background: linear-gradient(135deg, #eef2ff 0%, #f8fafc 50%, #e0e7ff 100%);
    }

    .login-page {
        min-height: calc(100vh - 70px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 15px;
    }

    .login-card {
        width: 100%;
        max-width: 430px;
        border: none;
        border-radius: 24px;
        overflow: hidden;
        background: rgba(255, 255, 255, 0.98);
        box-shadow: 0 20px 50px rgba(31, 41, 55, 0.15);
    }

    .login-header {
        background: linear-gradient(135deg, #0d6efd 0%, #4f46e5 55%, #7c3aed 100%);
        color: white;
        text-align: center;
        padding: 38px 28px 32px;
    }

    .brand-icon {
        width: 68px;
        height: 68px;
        margin: 0 auto 14px;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.18);
        border: 1px solid rgba(255, 255, 255, 0.25);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 34px;
        backdrop-filter: blur(5px);
    }

    .brand-title {
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 1.8px;
        text-transform: uppercase;
        opacity: 0.9;
        margin-bottom: 8px;
    }

    .welcome-title {
        font-size: 30px;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .welcome-text {
        margin: 0;
        font-size: 14px;
        opacity: 0.85;
    }

    .login-body {
        padding: 34px;
    }

    .form-label {
        font-size: 14px;
        font-weight: 700;
        color: #334155;
        margin-bottom: 8px;
    }

    .input-group-text {
        min-width: 48px;
        justify-content: center;
        background: #f8fafc;
        border-color: #dbe2ea;
        color: #475569;
    }

    .form-control {
        height: 48px;
        border-color: #dbe2ea;
        font-size: 14px;
        box-shadow: none !important;
    }

    .form-control:focus {
        border-color: #6366f1;
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.10) !important;
    }

    .password-toggle {
        width: 52px;
        border-color: #dbe2ea;
        background: white;
    }

    .password-toggle:hover {
        background: #f8fafc;
    }

    .login-btn {
        height: 50px;
        border: none;
        border-radius: 12px;
        font-size: 15px;
        font-weight: 700;
        background: linear-gradient(135deg, #0d6efd, #4f46e5);
        box-shadow: 0 8px 18px rgba(79, 70, 229, 0.22);
        transition: all 0.2s ease;
    }

    .login-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 24px rgba(79, 70, 229, 0.28);
    }

    .alert {
        border-radius: 12px;
        font-size: 14px;
        border: none;
    }

    .register-text {
        font-size: 14px;
        color: #64748b;
    }

    .register-link {
        font-weight: 700;
        text-decoration: none;
        color: #4f46e5;
    }

    .register-link:hover {
        color: #3730a3;
        text-decoration: underline;
    }

    .login-footer {
        text-align: center;
        margin-top: 24px;
        font-size: 12px;
        color: #94a3b8;
    }

    @@media (max-width: 576px) {
        .login-page {
            padding: 25px 12px;
        }

        .login-body {
            padding: 26px 22px;
        }

        .welcome-title {
            font-size: 26px;
        }
    }
</style>

<div class="login-page">

    <div class="login-card">

        <!-- Header -->
        <div class="login-header">

            <div class="brand-icon">
                🛒
            </div>

            <div class="brand-title">
                EMS Shopping System
            </div>

            <h1 class="welcome-title">
                Welcome Back
            </h1>

            <p class="welcome-text">
                Sign in to continue shopping
            </p>

        </div>

        <!-- Body -->
        <div class="login-body">

            <!-- Registration Success Message -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success text-center mb-4 shadow-sm">
                    ✅ @TempData["Success"]
                </div>
            }

            <form asp-action="Login"
                  method="post">

                <!-- Email -->
                <div class="mb-4">

                    <label asp-for="Email"
                           class="form-label">
                        Email Address
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            📧
                        </span>

                        <input asp-for="Email"
                               type="email"
                               class="form-control"
                               placeholder="Enter your email"
                               autocomplete="email"
                               required />

                    </div>

                </div>

                <!-- Password -->
                <div class="mb-4">

                    <label asp-for="Password"
                           class="form-label">
                        Password
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            🔒
                        </span>

                        <input asp-for="Password"
                               type="password"
                               id="password"
                               class="form-control"
                               placeholder="Enter your password"
                               autocomplete="current-password"
                               required />

                        <button type="button"
                                class="btn password-toggle"
                                id="togglePassword">
                            👁️
                        </button>

                    </div>

                </div>

                <!-- Error Message -->
                @if (ViewBag.Message != null)
                {
                    <div class="alert alert-danger text-center mb-4 shadow-sm">
                        ❌ @ViewBag.Message
                    </div>
                }

                <!-- Login Button -->
                <button type="submit"
                        class="btn btn-primary login-btn w-100">
                    🔐 Sign In
                </button>

            </form>

            <!-- Register Link -->
            <div class="text-center mt-4 register-text">

                Don't have an account?

                <a asp-action="Register"
                   class="register-link">
                    Create Account
                </a>

            </div>

            <div class="login-footer">
                Secure access to your EMS Shopping Account
            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        const passwordInput =
            document.getElementById("password");

        const togglePassword =
            document.getElementById("togglePassword");

        togglePassword.addEventListener("click", function () {

            if (passwordInput.type === "password") {

                passwordInput.type = "text";
                togglePassword.innerHTML = "🙈";

            }
            else {

                passwordInput.type = "password";
                togglePassword.innerHTML = "👁️";

            }

        });

    </script>

}