@model EMS.Models.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
}

<h2 class="mb-4">
    🔒 Change Password
</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (ViewBag.Message != null)
{
    <div class="alert alert-danger">
        @ViewBag.Message
    </div>
}

<div class="card shadow">

    <div class="card-body">

        <form asp-action="ChangePassword" method="post">

            <div class="mb-3">

                <label asp-for="OldPassword" class="form-label"></label>

                <input asp-for="OldPassword"
                       type="password"
                       class="form-control" />

                <span asp-validation-for="OldPassword"
                      class="text-danger"></span>

            </div>

            <div class="mb-3">

                <label asp-for="NewPassword" class="form-label"></label>

                <input asp-for="NewPassword"
                       type="password"
                       class="form-control" />

                <span asp-validation-for="NewPassword"
                      class="text-danger"></span>

            </div>

            <div class="mb-3">

                <label asp-for="ConfirmPassword" class="form-label"></label>

                <input asp-for="ConfirmPassword"
                       type="password"
                       class="form-control" />

                <span asp-validation-for="ConfirmPassword"
                      class="text-danger"></span>

            </div>

            <button type="submit"
                    class="btn btn-success">
                Update Password
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}